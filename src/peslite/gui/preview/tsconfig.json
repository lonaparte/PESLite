{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["index.ts", "renderer.ts", "parser.ts", "layout.ts", "routing.ts", "timeline.ts", "types.ts"]
}
