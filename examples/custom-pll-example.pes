# PESLite 0.4.0
# Grid-following converter using the automatically discovered voltage-adaptive PLL add-on.
base: {s_base: 2.0e6, v_ll_rms: 690.0, f0: 50.0}
buses:
  pcc: {c_pu: 0.02, r_d_pu: 0.5}
sources:
  grid: {bus: pcc, x_pu: 0.4, r_pu: 0.04}
units:
  vsc:
    type: vsc
    bus: pcc
    ac_filter: {l_f_pu: 0.2, r_f_pu: 0.01}
    dclink:
      vdc_ref: 1500.0
      capacitor: {c_pu: 35.0, r_esr_pu: 0.001}
      source: {type: current, i_pu: 0.9}
    pwm: {f_sw: 20000.0, modulation_limit: 0.95}
    ctrl:
      type: gfl
      loops:
        pll: {type: voltage_adaptive_pll, bandwidth: 20.0}
        cc: {type: dq_current_pi, bandwidth: 200.0}
        dvc: {type: dc_voltage_pi, kp_pu: 0.8, ki_pu: 90.0, limit_pu: 1.15,
              id0_export_pu: 0.9}
    protection: {overcurrent: {enable: 1, limit_pu: 1.5}}
events:
  connect_vsc: {type: connect, target: vsc, t: 0.0, ramp: 0.01}
simulation:
  t_end: 0.1
  solver: {dt: 25e-6}
  output: {record_every: 10}
