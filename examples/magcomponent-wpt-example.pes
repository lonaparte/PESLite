# PESLite 0.5.2
# Two-winding wireless power transfer built from a MagComponent and ordinary circuit components.
# The magnetic component defines the winding terminals and coupling; the source and receiver load
# remain independent electrical components.

@circuit
excitation -- primary -- magnetic_link -- secondary -- receiver_load

base:
  s_base: 5000.0
  v_ll_rms: 400.0
  f0: 85000.0

buses:
  primary: {phases: 1}
  secondary: {phases: 1}

sources:
  excitation:
    bus: primary
    l: 1.0e-6
    r: 0.1
    v: 400.0
    f: 85000.0

elements:
  magnetic_link:
    type: coupled_coils
    windings:
      primary: {positive: primary, negative: ground, r: 0.5}
      secondary: {positive: secondary, negative: ground, r: 0.5}
    inductance:
      - [100.0e-6, 20.0e-6]
      - [20.0e-6, 100.0e-6]
  receiver_load:
    type: resistor
    bus: secondary
    r: 20.0

simulation:
  t_end: 200.0e-6
  solver:
    dt: 50.0e-9
    linearisations: 0
  output:
    period: 1.0e-6
    record_every: 4
    signals: 1

meta:
  title: MagComponent WPT
  description: Two coupled windings transfer power from a sinusoidal source to a resistive receiver.
