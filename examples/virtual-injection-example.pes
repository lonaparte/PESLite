# PESLite 0.5.2
# Typed additive duty-command perturbation within a normal open-loop Buck controller.

@circuit
converter -- output -- load

base:
  s_base: 500.0
  v_ll_rms: 230.0
  f0: 50.0

buses:
  output: {phases: 1, c: 100.0e-6}

elements:
  load: {type: resistor, bus: output, r: 2.0}

units:
  converter:
    type: dc_converter
    bus: output
    filter: {l_f: 0.5e-3, r_f: 0.05}
    dclink:
      vdc_ref: 48.0
      source: {type: voltage}
    pwm: {f_sw: 20000.0}
    ctrl:
      type: open_loop
      loops:
        DutyModulation: {}
        VirtualDutyInjection: {amplitude: 0.03, frequency: 100.0}
      references: {duty: 0.4}
      connections:
        VirtualDutyInjection.signal: references.duty
        DutyModulation.duty: VirtualDutyInjection.injected

simulation:
  t_end: 0.015
  solver: {dt: 2.5e-6, linearisations: 0}
  output: {period: 1.0e-5, signals: 1}

meta:
  title: Virtual control signal injection
  description: The typed graph exposes before, after and injected control signals.
