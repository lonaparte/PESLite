model: ../buck-open-loop-example.pes
state_policy: continue

@debug
~ simulation.t_end = 0.015
~ simulation.output.period = 0.00001
- converter.references.duty -> converter.DutyModulation.duty
+ Test.out -> converter.DutyModulation.duty

@sources
Test:
  type: sine
  amplitude: 0.03
  frequency: 100.0
  offset: 0.4

@probe
before: converter.references.duty
after: converter.Test.out
effective: converter.DutyModulation.duty

@analysis
response:
  type: frequency_response
  input: after
  output: effective
  frequency: 100.0

@checks
duty_limit:
  signal: effective
  metric: max
  operator: <=
  value: 1.0
