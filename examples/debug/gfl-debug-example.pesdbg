model: ../gfl-example.pes
state_policy: continue

@debug
~ simulation.t_end = 0.02
~ simulation.output.period = 0.0001
Test: sine
  amplitude: 0.02
  frequency: 500.0
  offset: 0.1

@vsc
- CurrentLoop.u_dq -> ThreePhaseModulation.u_dq
+ Test.out -> ThreePhaseModulation.u_dq

@probe
original: vsc.CurrentLoop.u_dq
injected: vsc.Test.out
effective: vsc.ThreePhaseModulation.u_dq

@analysis
response:
  type: frequency_response
  input: injected.re
  output: effective.re
  frequency: 500.0

@checks
command_limit:
  signal: effective.abs
  metric: max
  operator: <=
  value: 0.2
