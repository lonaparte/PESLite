# PESLite 0.5.1
# Open-loop Buck with a repeating duty-ratio table evaluated at controller interrupts.

base:
  s_base: 500.0
  v_ll_rms: 230.0
  f0: 50.0

buses:
  output:
    phases: 1
    c: 100.0e-6

elements:
  load:
    type: resistor
    bus: output
    r: 2.0

signals:
  duty_profile:
    time: [0.0, 0.001, 0.002]
    value: [0.35, 0.55, 0.35]
    repeat: true

units:
  converter:
    type: dc_converter
    bus: output
    filter: {l_f: 0.5e-3, r_f: 0.05}
    dclink:
      vdc_ref: 48.0
      source: {type: voltage}
    pwm:
      f_sw: 20000.0
    ctrl:
      type: open_loop
      loops:
        DutyModulation: {}
      references:
        duty: signals.duty_profile

simulation:
  t_end: 0.006
  solver:
    dt: 2.5e-6
    linearisations: 0
  output:
    period: 10.0e-6
    signals: 1

meta:
  title: Table-driven Buck reference
  description: Repeating linear duty-ratio reference applied on the existing control schedule.
