# PESLite 0.4.0
# Two converters, each on its own bus and connected to the PCC by a line:
# a grid-forming unit (PSC, 2 MVA, 20 kHz) and a grid-following unit (1 MVA, 10 kHz).
base: {s_base: 2.0e6, v_ll_rms: 690.0, f0: 50.0}
buses:
  pcc: {c_pu: 0.02, r_d_pu: 0.5}
  bus1: {c_pu: 0.02, r_d_pu: 0.5}
  bus2: {c_pu: 0.02, r_d_pu: 0.5}
branches:
  line1: {bus1: bus1, bus2: pcc, x_pu: 0.05, r_pu: 0.005}
  line2: {bus1: bus2, bus2: pcc, x_pu: 0.08, r_pu: 0.008}
sources:
  grid:
    bus: pcc
    x_pu: 0.4
    r_pu: 0.04
units:
  vsc_1:
    type: vsc
    bus: bus1
    ac_filter: {l_f_pu: 0.2, r_f_pu: 0.01}
    dclink:
      vdc_ref: 1500.0
      source: {type: voltage}
    pwm: {f_sw: 20000.0, modulation_limit: 0.95}
    ctrl:
      type: gfm
      loops:
        power: {type: power}
        sync: {type: psc, k_p_pu: 6.2832, k_vi: 20.0}
        vi: {type: virtual_impedance}
        damp: {type: active_damping, r_a_pu: 0.2, alpha_d: 40.0}
      references: {p_ref_pu: 0.5}
    protection: {overcurrent: {enable: 1, limit_pu: 1.5}}
  vsc_2:
    type: vsc
    bus: bus2
    s_base: 1.0e6
    ac_filter: {l_f_pu: 0.2, r_f_pu: 0.01}
    dclink:
      vdc_ref: 1500.0
      capacitor: {c_pu: 35.0, r_esr_pu: 0.001}
      source: {type: current, i_pu: 0.9}
    pwm: {f_sw: 10000.0, modulation_limit: 0.95}
    ctrl:
      type: gfl
      loops:
        pll: {type: srf_pll, kp_pu: 20.0, ki_pu: 1200.0}
        cc: {type: dq_current_pi, bandwidth: 200.0}
        dvc: {type: dc_voltage_pi, kp_pu: 0.8, ki_pu: 90.0, limit_pu: 1.15, id0_export_pu: 0.9}
    protection:
      overcurrent: {enable: 1, limit_pu: 1.15}
      undervoltage: {enable: 1, limit_pu: 0.5}
      overvoltage: {enable: 1, limit_pu: 1.2}
      rocof: {enable: 1, limit: 1.0}
events:
  connect_vsc_1: {type: connect, target: vsc_1, t: 0.05, ramp: 0.3}
  connect_vsc_2: {type: connect, target: vsc_2, t: 0.05, ramp: 0.3}
  p_step: {type: set, t: 0.5, set: {units.vsc_1.ctrl.references.p_ref_pu: 0.3}}
  grid_f: {type: set, t: 0.75, set: {sources.grid.f: 49.8}}
simulation:
  t_end: 1.0
  solver: {dt: 25e-6}
  stop_on_trip: 0
  output: {record_every: 10}
