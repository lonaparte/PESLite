{
  "file-groups": {
    "all": [
      "src/peslite/**/*.py",
      "src/peslite/gui/preview/*",
      "src/peslite/gui/preview/tests/*",
      "src/peslite/gui/ui/**/*",
      "src/peslite/gui/vscode/**/*",
      "src/peslite/gui/web_dist/*"
    ],
    "addons": [
      "src/peslite/addons/components/**/*.py",
      "src/peslite/addons/control/**/*.py",
      "src/peslite/addons/formats/**/*.py",
      "src/peslite/addons/functions/**/*.py",
      "!src/peslite/addons/components/magport.py",
      "!src/peslite/addons/components/magcircuit.py",
      "!src/peslite/addons/functions/magport.py",
      "!src/peslite/addons/functions/magcircuit.py",
      "!src/peslite/addons/components/__init__.py",
      "!src/peslite/addons/control/__init__.py",
      "!src/peslite/addons/formats/__init__.py",
      "!src/peslite/addons/functions/__init__.py",
      "!src/peslite/addons/components/advanced_thermal.py"
    ],
    "full-addons": [
      "src/peslite/addons/components/magport.py",
      "src/peslite/addons/components/magcircuit.py",
      "src/peslite/addons/functions/magport.py",
      "src/peslite/addons/functions/magcircuit.py",
      "src/peslite/addons/components/advanced_thermal.py"
    ],
    "gui": [
      "src/peslite/gui/**/*.py",
      "src/peslite/gui/preview/*",
      "src/peslite/gui/preview/tests/*",
      "src/peslite/gui/ui/**/*",
      "src/peslite/gui/vscode/**/*",
      "src/peslite/gui/web_dist/*"
    ]
  },
  "distributions": {
    "peslite-core": {
      "project": "pyproject.toml",
      "include": [
        "all"
      ],
      "exclude": [
        "addons",
        "full-addons",
        "gui"
      ],
      "files": [
        "examples/templates/*"
      ]
    },
    "peslite": {
      "project": "packages/peslite/pyproject.toml",
      "include": [
        "addons"
      ],
      "files": [
        "examples/*.pes"
      ]
    },
    "peslite-gui": {
      "project": "packages/gui/pyproject.toml",
      "include": [
        "gui"
      ],
      "build-steps": [
        {
          "cwd": "src/peslite/gui/preview",
          "command": [
            "npm",
            "ci",
            "--ignore-scripts",
            "--no-audit",
            "--no-fund"
          ]
        },
        {
          "cwd": "src/peslite/gui/preview",
          "command": [
            "npm",
            "run",
            "build"
          ]
        },
        {
          "cwd": "src/peslite/gui/ui",
          "command": [
            "npm",
            "ci",
            "--ignore-scripts",
            "--no-audit",
            "--no-fund"
          ]
        },
        {
          "cwd": "src/peslite/gui/ui",
          "command": [
            "npm",
            "run",
            "build"
          ]
        }
      ]
    },
    "peslite-full": {
      "project": "packages/full/pyproject.toml",
      "include": [
        "full-addons"
      ]
    }
  }
}
